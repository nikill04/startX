# Copy this file to ".env" and fill in the values.

# MongoDB connection string. Leave empty to use a local MongoDB (mongodb://127.0.0.1:27017/startX).
# For deployment use a free MongoDB Atlas database. Use Atlas's "standard" string
# (mongodb://USER:PASSWORD@host1,host2,host3/startX?ssl=true&authSource=admin&replicaSet=...),
# because the mongodb+srv:// form needs a DNS lookup that fails on some Windows PCs.
MONGO_URI=

# Admin login for /admin/login (defaults: admin / 12345)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345

# Optional: Gmail address + Gmail "App Password" used to send notification emails.
# Leave empty to turn emails off.
EMAIL_USER=
EMAIL_PASS=

# Optional: send emails through the Vercel function frontend/api/send-email.js instead of
# Gmail directly (needed on Render's free plan, which blocks email ports).
# The same EMAIL_USER, EMAIL_PASS and EMAIL_RELAY_SECRET must also be set in the Vercel project.
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=
